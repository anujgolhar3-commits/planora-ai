{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "styles.css",
          "app.js",
          "index.html",
          "login.html",
          "dashboard.html",
          "privacy.html",
          "terms.html",
          "notification_chime.wav",
          "*.css",
          "*.js",
          "*.html",
          "*.wav"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
